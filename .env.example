# Pagou (gateway de pagamento) — URL base da API
PAGOU_BASE_URL=coloque_aqui

# Pagou — API key
PAGOU_API_KEY=coloque_aqui

# Pagou — API secret
PAGOU_API_SECRET=coloque_aqui

# Pagou — chave pública (usada no client/checkout)
PAGOU_PUBLIC_KEY=coloque_aqui

# Pagou — segredo para validar assinatura dos webhooks
PAGOU_WEBHOOK_SECRET=coloque_aqui

# Utmify — token de API para envio de eventos/tracking
UTMIFY_API_TOKEN=coloque_aqui

# Yampi — segredo para validar assinatura do webhook
YAMPI_WEBHOOK_SECRET=coloque_aqui

# RastroCode — API key para rastreamento de pedidos
RASTROCODE_API_KEY=coloque_aqui

# Meta Ads (Facebook) — ID do Pixel, exposto ao client (prefixo VITE_)
VITE_META_PIXEL_ID=
